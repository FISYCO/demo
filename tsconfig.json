{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@seavora/ui": ["ui-kit/index.ts"],
      "@seavora/ui/*": ["ui-kit/*"]
    }
  },
  "include": ["ui-kit", "apps"]
}
